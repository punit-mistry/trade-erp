# --- Next.js app (.env.local) ---------------------------------------------
# Written automatically by `npx convex dev`. Public: safe to expose to the browser.
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
# Deployment name used by the Convex CLI (written by `npx convex dev`).
CONVEX_DEPLOYMENT=dev:<your-deployment>

# --- Convex deployment environment (NOT in .env.local) ----------------------
# Set these on the Convex deployment with `npx convex env set NAME value`
# (or let `npx @convex-dev/auth` set them for you). Never put them in NEXT_PUBLIC_*.
#
#   JWT_PRIVATE_KEY      RS256 private key used by Convex Auth to sign session tokens
#   JWKS                 matching public key set
#   SITE_URL             e.g. http://localhost:3000 (only needed for OAuth/magic links)
#   ERP_ALLOW_DEMO_SEED  "true" ONLY on dev/demo deployments to allow seed:loadDemoData
#   GROQ_AI_API_KEY      API key for GROQ AI integration